{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "helm-values",
    "helmv3",
    "github-actions"
  ],
  "packageRules": [
    {
      "description": "Do not automerge Helm values updates.",
      "matchManagers": [
        "helm-values"
      ],
      "automerge": false,
      "prBodyNotes": [
        "Image versions alone are not a complete chart release. Compatibility notes belong in the chart CHANGELOG.md; runtime values, schema defaults, appVersion, image metadata, chart version and generated catalog are reviewed together.",
        "Container-wrapper changes and all intervening app releases are reviewed for new/removed runtime configuration, persistence and migration changes before merge."
      ]
    },
    {
      "description": "Do not update embedded database images managed by application chart compatibility.",
      "matchPackageNames": [
        "postgres",
        "mysql",
        "mariadb"
      ],
      "enabled": false
    },
    {
      "description": "Exclude historical Ubuntu-style qBittorrent tags misclassified as application upgrades; reassess this ceiling for a genuine future v10.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "lscr.io/linuxserver/qbittorrent"
      ],
      "versioning": "semver",
      "allowedVersions": "/^[4-9]\\.[0-9]+\\.[0-9]+$/"
    },
    {
      "description": "Redis and InfluxDB upgrades need app/server and persisted-format compatibility review.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "redis",
        "influxdb"
      ],
      "automerge": false,
      "prBodyNotes": [
        "This is a database/cache dependency update. Upstream application support, the exact server version, persistence migration, backups and rollback constraints must be verified before it is considered merge-ready."
      ]
    },
